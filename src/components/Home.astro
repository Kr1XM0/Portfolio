---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import mePhoto from '../assets/yo.webp'
---

<main class="flex justify-between items-center pt-24 max-sm:px-5">

  <div class="w-1/2 max-sm:w-full">
    <div>
      <h1 class="text-7xl dark:text-white">Hi, I'm Krix</h1>
      <span class="text-4xl dark:text-white">
        <span id="big" class="inline-block min-h-[1.2em]" aria-label="Web Developer, Digital Builder, Logic Architect"></span>
      </span>
      <p class="my-5 text-pretty dark:text-white">I create beautiful function and user-centered experiences. With 2+ 
        years of experiences in web development
      </p>
    </div>

    <div class="flex flex-col ">
      <div class="flex gap-4 mb-5 dark:text-white">
        <p class="flex items-center gap-1.5 mr-5">
          <Icon name="meteor-icons:location-dot" size={24} /> 
          Based in El Salvador 
        </p>
        <p class="flex items-center gap-1.5 mr-5">
          <Icon name="meteor-icons:circle-check" size={24} /> 
          Available Now
        </p>
      </div>

      <div class="flex gap-4 mb-5">
        <a href="https://wa.me/+50362613639" target="_blank" class="flex items-center gap-1.5 py-2.5 px-4 rounded-xl border-2 max-sm:text-base transition-colors hover:text-white hover:bg-neutral-900 dark:hover:text-black dark:hover:bg-white dark:text-white dark:border-white" >
          <Icon name="meteor-icons:arrow-right-long" size={20} />
          Contact Me
        </a>
        <button onclick="window.open('Cristian_Marrero_es.pdf', '_blank')" class="flex cursor-pointer items-center gap-1.5 py-2.5 px-4 rounded-xl border-2 max-sm:text-base transition-colors hover:text-white hover:bg-neutral-900 dark:hover:text-black dark:hover:bg-white dark:text-white dark:border-white" >
          <Icon name="meteor-icons:download" size={20} />
          Download CV
        </button>
      </div>
    </div>

    <hr class="dark:text-white">
    <div class="flex items-center gap-8 max-sm:gap-4 my-8 text-xl">
      <p class="dark:text-white">Follow Me:</p>
      <a class="bg-neutral-500/20 hover:bg-neutral-900 hover:text-white dark:text-white dark:hover:bg-neutral-200 dark:hover:text-black transition-colors p-2.5 rounded-lg" target="_blank" href="https://github.com/Kr1XM0">
          <Icon name="meteor-icons:github" size={24} /> 
      </a>
      <a class="bg-neutral-500/20 hover:bg-neutral-900 hover:text-white dark:text-white dark:hover:bg-neutral-200 dark:hover:text-black transition-colors p-2.5 rounded-lg" target="_blank" href="https://www.linkedin.com/in/cristian-marrero-82002a342">
          <Icon name="meteor-icons:linkedin" size={24} /> 
      </a>
      <a class="bg-neutral-500/20 hover:bg-neutral-900 hover:text-white dark:text-white dark:hover:bg-neutral-200 dark:hover:text-black transition-colors p-2.5 rounded-lg" target="_blank" href="https://www.instagram.com/_krixd_">
          <Icon name="meteor-icons:instagram" size={24} /> 
      </a>
      <a class="bg-neutral-500/20 hover:bg-neutral-900 hover:text-white dark:text-white dark:hover:bg-neutral-200 dark:hover:text-black transition-colors p-2.5 rounded-lg" target="_blank" href="https://www.facebook.com/Kristian.Marrero0">
          <Icon name="meteor-icons:facebook" size={24} /> 
      </a>
    </div>
  </div>

  <div id="group" class="relative max-w-sm max-sm:hidden h-80 ">
    <Image src={mePhoto} alt="photo of me" loading="eager" decoding="async" class="object-cover h-full w-full rounded-lg" />
  </div>
  
</main>

<script>
  const messages = ["Web Developer", "Digital Builder", "Logic Architect"];
  const typeDelay = 80;
  const eraseDelay = 40;
  const waitWritten = 3000;
  const waitErased = 400;

  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  async function run(el: HTMLElement) {
    let i = 0;
    while (true) {
      const text = messages[i];

      for (let c = 1; c <= text.length; c++) {
        el.textContent = text.slice(0, c);
        await sleep(typeDelay);
      }

      await sleep(waitWritten);

      for (let c = text.length - 1; c >= 0; c--) {
        el.textContent = text.slice(0, c);
        await sleep(eraseDelay);
      }

      await sleep(waitErased);
      i = (i + 1) % messages.length;
    }
  }

  const el = document.getElementById("big");
  if (el) run(el);
</script>

<style>
  #big::after {
  content: "";
  display: inline-block;
  width: 3px;
  height: 1em;
  margin-left: 2px;
  background: currentColor;
  vertical-align: -0.1em;
  animation: blink 1s steps(1) infinite;
}

@keyframes blink {
  50% { opacity: 0; }
}
    #group::after {
      content: "";
      position: absolute;
      top: 50px;
      left: 40px;
      right: -55px;
      bottom: -55px;
      border: 2px solid #6f6f6f;
      border-radius: 8px;
      transition: all 0.3s ease;
      z-index: -1;
    }
</style>
