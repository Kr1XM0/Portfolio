---
import { Icon } from 'astro-icon/components';
---

<div class="max-w-3xl m-auto flex justify-center sticky top-5 z-20 max-sm:hidden">
  <div class="flex items-center justify-evenly w-full h-14 rounded-3xl border border-neutral-200/50 shadow-xl bg-white dark:shadow-none dark:bg-neutral-800 ">
    <a 
    href="#theme_toggle" 
    class="dark:text-good-white dark:hover:text-good-black dark:hover:bg-good-white hover:bg-good-black hover:text-good-white">
    <Icon name="meteor-icons:user" size={20} /> About Me
    </a>
    <a 
    href="#Experience"
    class="dark:text-good-white dark:hover:text-good-black dark:hover:bg-good-white hover:bg-good-black hover:text-good-white">
      <Icon name="meteor-icons:book-open" size={20} /> Experience
    </a>
    <a 
    href="#ClientProjects"
    class="dark:text-good-white dark:hover:text-good-black dark:hover:bg-good-white hover:bg-good-black hover:text-good-white">
      <Icon name="meteor-icons:folder" size={20} />Projects
    </a>
    <a 
    href="#Contact"
    class="dark:text-good-white dark:hover:text-good-black dark:hover:bg-good-white hover:bg-good-black hover:text-good-white">
      <Icon name="meteor-icons:envelope" size={20} />Contact
    </a>
  </div>
</div>

<style>
  
  a{
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 5px;
    border-radius: 20px;
    padding: 8px 14px;
    text-decoration: none;
    transition: all ease-in-out .3s;
  }


</style>