---
import ProjectCards from "./Project_Cards.astro";
---

<main id="Projects" class="w-full flex flex-col justify-center items-center pt-24">
  <div class="flex flex-col items-center">
    <h2 class="text-5xl font-bold text-pretty dark:text-white">Featured Work</h2>
    <p class="dark:text-neutral-200">A sample of some personal projects carried out </p>
  </div>

  <div class="flex flex-wrap gap-10 justify-center my-5 max-sm:px-5">

    <ProjectCards 
    project_name="URL Shortener"
    project_description="Personal link shortener available for community use, fast and easy"
    project_img="/URL_Shortener.webp"
    technologies={["Express","Node.js","Postgress"]}
    github_url="https://github.com/Kr1XM0/ShortUrls-App"
    web_url="https://kut.fly.dev/"
    />

    <ProjectCards 
    project_name="SoliTime"
    project_description="Weather app with varied and timely information about the weather in your area"
    project_img="/SoliTime.webp"
    technologies={["React","TailwindCSS"]}
    github_url="https://github.com/Kr1XM0/Weather_App"
    web_url="https://weather-app-jn5t.onrender.com/"
    />
    
    <ProjectCards 
    project_name="Invoice Creator App"
    project_description="A quick and effective solution for creating invoices for your business"
    project_img="/InvoiceCreator.webp"
    technologies={["React","TailwindCSS"]}
    github_url="https://github.com/Kr1XM0/Invoice-Creator"
    web_url="https://uinvoic3.netlify.app/"
    />
    
    <ProjectCards 
    project_name="QR Code"
    project_description="Convert your URLs into QR codes and share them with your friends"
    project_img="/QR.webp"
    technologies={["JS","CSS","HTML"]}
    github_url="https://github.com/Kr1XM0/QRGenerator.github.io"
    web_url="https://kr1xm0.github.io/QRGenerator.github.io/"
    />

    </div>
</main>

<style>
  .projects-header h2 {
    font-size: 30px;
  } 
</style>
